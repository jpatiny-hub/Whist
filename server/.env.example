# URL PostgreSQL — utilise ta chaîne de connexion Neon (ou toute autre base
# PostgreSQL). Voir le README pour créer une base Neon gratuite.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Comma-separated list of origins allowed to call the API (your web app's URL(s)).
CORS_ORIGIN="http://localhost:5173"
